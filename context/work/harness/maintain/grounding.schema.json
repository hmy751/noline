{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "status",
    "starting_state",
    "unresolved",
    "question"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "workspace_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["grounded", "needs_user_decision"]
    },
    "starting_state": {
      "type": "string",
      "minLength": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": ["string", "null"]
    }
  }
}
