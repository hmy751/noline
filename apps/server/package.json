{
  "name": "@apps/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docker:up": "/usr/local/bin/docker compose up -d",
    "docker:down": "/usr/local/bin/docker compose down",
    "docker:logs": "/usr/local/bin/docker compose logs -f postgres",
    "db:generate": "NODE_ENV=development drizzle-kit generate:pg",
    "db:push": "NODE_ENV=development drizzle-kit push:pg",
    "db:studio": "NODE_ENV=development drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@repo/schema": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.3",
    "ulid": "^3.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.12",
    "drizzle-kit": "^0.20.9",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
