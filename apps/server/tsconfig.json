{
  "extends": "../../packages/typescript-config/src/base.json",
  "compilerOptions": {
    // Build output
    "composite": false,
    "outDir": "./dist",
    "rootDir": "./src",

    // ESM 설정 (base.json의 CommonJS 오버라이드)
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],

    // 서버는 다른 앱에서 참조하지 않으므로 declaration 불필요
    "declaration": false,
    "declarationMap": false,

    "resolveJsonModule": true,

    // tsx/tsup 최적화
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
