{
  "name": "noline",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "pnpm --filter @repo/schema build",
    "client": "pnpm --filter @apps/client",
    "server": "pnpm --filter @apps/server",
    "schema": "pnpm --filter @repo/schema",
    "harness:check": "node scripts/check-harness.mjs",
    "client:expo-check": "pnpm --filter @apps/client exec expo install --check",
    "ota:publish": "node apps/client/scripts/ota/publish.mjs",
    "ota:register-local-build": "node apps/client/scripts/ota/register-local-build.mjs",
    "lint": "pnpm -r --no-bail run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.6.2",
    "typescript": "^5.5.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  }
}
