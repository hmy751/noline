{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.agents/hooks/block-direct-eas-update.py\"; [ ! -f \"$H\" ] || python3 \"$H\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
